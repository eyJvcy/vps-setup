#!/bin/bash
# ============================================
# CONFIGURATION GLOBALE DU VPS
# ⚠️  MODIFIEZ UNIQUEMENT CE FICHIER !
# ============================================

# ============================================
# UTILISATEURS
# ============================================
export VPS_USERS="noleak 42 noleak_pro"

# Configuration Git (format: "user:nom:email")
# Laissez vide ("") pour configuration interactive
export VPS_GIT_CONFIG=(
    "noleak:John Doe:john@example.com"
    "42:John Doe:john@student.42.fr"
    "noleak_pro:John Doe:john@company.com"
)

# ============================================
# SSH
# ============================================
export VPS_SSH_PORT=2222
export VPS_SSH_DISABLE_ROOT=true
export VPS_SSH_DISABLE_PASSWORD=true

# ============================================
# PARE-FEU
# ============================================
export VPS_ALLOW_HTTP=false
export VPS_ALLOW_HTTPS=false
export VPS_ALLOW_DEV_PORTS_3000=true
export VPS_ALLOW_DEV_PORTS_8000=true

# ============================================
# OUTILS DE DÉVELOPPEMENT
# ============================================
export VPS_INSTALL_C_CPP=true
export VPS_INSTALL_NODE=true
export VPS_NODE_VERSION=20
export VPS_INSTALL_PYTHON=true
export VPS_INSTALL_DOCKER=true
export VPS_INSTALL_RUST=true
export VPS_INSTALL_GO=true
export VPS_INSTALL_NORMINETTE=false
export VPS_INSTALL_CRITERION=true

# ============================================
# SHELL
# ============================================
export VPS_INSTALL_ZSH=true
export VPS_ZSH_AS_DEFAULT=true
export VPS_ZSH_THEME="powerlevel10k"

# ============================================
# ÉDITEUR
# ============================================
export VPS_CONFIGURE_VIM=true
export VPS_INSTALL_NEOVIM=true

# ============================================
# SYSTÈME
# ============================================
export VPS_TIMEZONE="Europe/Paris"
export VPS_SWAP_SIZE="2G"
export VPS_LOCALE="en_US.UTF-8"

# ============================================
# SÉCURITÉ
# ============================================
export VPS_FAIL2BAN_BANTIME=3600
export VPS_FAIL2BAN_MAXRETRY=3
export VPS_FAIL2BAN_FINDTIME=600

# ============================================s
# OPTIONS AVANCÉES
# ============================================
export VPS_AUTO_CONFIRM=false
export VPS_SKIP_UPDATES=false
export VPS_VERBOSE=true

# ============================================
# REPOSITORY
# ============================================
export VPS_REPO_URL="https://github.com/eyJvcy/vps-setup"
export VPS_REPO_BRANCH="main"